+
+/* NotProton: some games turn features off once ntdll answers wine_get_version (The Witcher 3
+ * 5.0 then never starts NVIDIA Streamline, so it offers no DLSS). With
+ * NOTPROTON_HIDE_WINE_EXPORTS set, a lookup of ntdll's wine_* exports by name fails as on
+ * Windows. __wine_* stays: winecrt0's __wine_init_unix_call in every builtin looks those up.
+ * Other modules are untouched: gdi32 and user32 look up wine_ names in display drivers and
+ * imm32. kernel32 and kernelbase each carry this copy. */
+static BOOL notproton_hidden_export( HMODULE module, const char *name )
+{
+    static int hide = -1;
+    static HMODULE ntdll;
+
+    if (hide == -1)
+    {
+        ntdll = GetModuleHandleW( L"ntdll.dll" );
+        hide = GetEnvironmentVariableW( L"NOTPROTON_HIDE_WINE_EXPORTS", NULL, 0 ) != 0;
+    }
+    if (!hide || module != ntdll || strncmp( name, "wine_", 5 )) return FALSE;
+    TRACE( "NotProton: hiding ntdll.%s\n", debugstr_a(name) );
+    return TRUE;
 }
 
